meta {
  name: Start Route
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/routes/f7f16595-8537-486b-9027-ee419435980c/start
  body: none
  auth: none
}

vars:post-response {
  collectionId: res.body.collections[0].id
  collectionId2: res.body.collections[1].id
}

assert {
  res.status: eq 200
  res.body.status: eq "IN_PROGRESS"
}
