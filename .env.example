# GENERAL CONFIGURATION
NODE_ENV='local'
DOMAIN_ADDRESS='http://localhost'
API_PATH='/api/v1'
API_NAME='petropolis-circularidade'
WILL_DISABLE_AUTHENTICATION=true
API_VERSION='0.1.0'
TCP_PORT=3000

# DATABASE CONFIGURATION
